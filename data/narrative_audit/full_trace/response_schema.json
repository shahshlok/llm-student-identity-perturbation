{
  "$defs": {
    "PredictedSemanticEvent": {
      "additionalProperties": false,
      "properties": {
        "predicted_event_index_1idx": {
          "minimum": 1,
          "title": "Predicted Event Index 1Idx",
          "type": "integer"
        },
        "event_type": {
          "enum": [
            "change",
            "saida_testar",
            "submit",
            "kill_program",
            "keyHandled",
            "tab_click",
            "idle_gap"
          ],
          "title": "Event Type",
          "type": "string"
        },
        "primary_line_0idx": {
          "minimum": -1,
          "title": "Primary Line 0Idx",
          "type": "integer"
        },
        "secondary_line_0idx": {
          "minimum": -1,
          "title": "Secondary Line 0Idx",
          "type": "integer"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "predicted_event_index_1idx",
        "event_type",
        "primary_line_0idx",
        "secondary_line_0idx",
        "detail"
      ],
      "title": "PredictedSemanticEvent",
      "type": "object"
    },
    "V61EpisodeHypothesis": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "estimated_probability": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Estimated Probability",
          "type": "number"
        },
        "student_state_summary": {
          "minLength": 1,
          "title": "Student State Summary",
          "type": "string"
        },
        "predicted_event_tape": {
          "items": {
            "$ref": "#/$defs/PredictedSemanticEvent"
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Predicted Event Tape",
          "type": "array"
        }
      },
      "required": [
        "label",
        "estimated_probability",
        "student_state_summary",
        "predicted_event_tape"
      ],
      "title": "V61EpisodeHypothesis",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "v6_1_predicted_episode_response_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "instructor_summary": {
      "minLength": 1,
      "title": "Instructor Summary",
      "type": "string"
    },
    "next_episode_hypotheses": {
      "items": {
        "$ref": "#/$defs/V61EpisodeHypothesis"
      },
      "maxItems": 5,
      "minItems": 2,
      "title": "Next Episode Hypotheses",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "instructor_summary",
    "next_episode_hypotheses"
  ],
  "title": "V61PredictedEpisodeResponse",
  "type": "object"
}
